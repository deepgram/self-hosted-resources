  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0
      },
      {
        "allValue": ".*",
        "datasource": "${DS_PROMETHEUS}",
        "includeAll": true,
        "label": "Scrape Job",
        "name": "job",
        "options": [],
        "query": "label_values(engine_tts_first_transcoded_byte_latency_count, job)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
